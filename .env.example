# Copy to .env and fill secrets. Never commit .env.
# Shared by all services via docker-compose.yml

# --- Textbooks on host (LPE + IAE Chroma ingest only) ---
# Analytics uses PDFs from learner-analytics-genai-support/Data/Syllabi/ (baked into its image).
# Local sibling repos:
TEXTBOOKS_HOST_PATH=../learning-path-engine/backend/data/textbooks
# Core/IAE EC2 after `git submodule update --init`:
# TEXTBOOKS_HOST_PATH=./services/learning-path-engine/backend/data/textbooks

# --- Frontend origins (Next.js on host or EC2 :3000) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://YOUR_ELASTIC_IP:3000

# Which services this machine runs (compose profiles).
# Local / one EC2: all three. Split EC2: only the profile for that box.
COMPOSE_PROFILES=core,analytics,iae
# Core box (LPE 8000, UM 8001, Gaming 8002):
# COMPOSE_PROFILES=core
# Analytics box (8003):
# COMPOSE_PROFILES=analytics
# IAE box (8004):
# COMPOSE_PROFILES=iae

# --- Shared LLM key (LPE / IAE / Analytics / Gaming) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b
LLM_PROVIDER=groq
LLAMA_PROVIDER=groq
LLAMA_MODEL=openai/gpt-oss-120b

# --- Databases (Neon is fine for local + demo; one URL or per-service) ---
# If every service shares one Neon project with different schemas:
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional overrides (leave blank to reuse DATABASE_URL):
# LPE_DATABASE_URL=
# CONTENT_DATABASE_URL=
# UM_DATABASE_URL=sqlite:///./data/users.db
# IAE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# ANALYTICS_DATABASE_URL=

# --- User Management ---
JWT_SECRET=dev-change-me-user-management-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360
EXPOSE_RESET_TOKEN=true

# --- IAE public base (browser-facing) ---
# Local: localhost. On AWS: use your Elastic IP (see docs/elastic-ip.md)
IAE_API_BASE_URL=http://localhost:8004

# --- In-compose service URLs ---
# Same machine (docker network):
# COMPONENT_1_URL=http://learning-path-engine:8000
# COMPONENT_3_URL=http://gaming-backend:8002
# COMPONENT_4_URL=http://learner-analytics:8003
# ANALYTICS_BASE_URL=http://learner-analytics:8003
# Split EC2 — IAE box must use public IPs of the other instances:
# COMPONENT_1_URL=http://CORE_ELASTIC_IP:8000
# COMPONENT_3_URL=http://CORE_ELASTIC_IP:8002
# COMPONENT_4_URL=http://ANALYTICS_ELASTIC_IP:8003
# ANALYTICS_BASE_URL=http://ANALYTICS_ELASTIC_IP:8003

# --- AWS / ECR (see docs/elastic-ip.md and docs/ecr-pipeline.md) ---
# Local PC: leave IMAGE_* unset (compose defaults to sci-path-*:local).
# EC2 (pull from ECR instead of building):
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=011877215030
ECR_REGISTRY=011877215030.dkr.ecr.ap-south-1.amazonaws.com
EC2_HOST=3.6.20.31
# S3_BUCKET=
# IAE_API_BASE_URL=http://3.6.20.31:8004

# ECR image URIs (EC2 only — uncomment after first push to ECR):
# IMAGE_LPE=011877215030.dkr.ecr.ap-south-1.amazonaws.com/sci-path/lpe:latest
# IMAGE_UM=011877215030.dkr.ecr.ap-south-1.amazonaws.com/sci-path/um:latest
# IMAGE_GAMING=011877215030.dkr.ecr.ap-south-1.amazonaws.com/sci-path/gaming:latest
# IMAGE_ANALYTICS=011877215030.dkr.ecr.ap-south-1.amazonaws.com/sci-path/analytics:latest
# IMAGE_IAE=011877215030.dkr.ecr.ap-south-1.amazonaws.com/sci-path/iae:latest
